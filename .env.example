# Copy this file to ".env" (same folder as package.json) and fill it in. Never share your real .env.
# AI chat assistant. LEAVE AI_API_KEY EMPTY to use the free built-in "no-AI mode" (answers from your shop data + knowledge base).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=700
# Your public website address (used for links in chat). Leave empty on your own PC.
SITE_URL=
# Spending protection: messages per visitor per minute / per day, and for the whole site per day
AI_RATE_PER_MINUTE=8
AI_RATE_PER_DAY=80
AI_DAILY_CAP=500
# Database (only if different from the XAMPP defaults)
#DB_HOST=localhost
#DB_USER=root
#DB_PASSWORD=
# Set to 1 when the site runs behind Nginx / a proxy
#TRUST_PROXY=1
